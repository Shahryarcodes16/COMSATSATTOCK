# SMTP Email Dispatch Configuration
# Generate an App Password in your Google Account:
# Google Account -> Security -> 2-Step Verification -> App Passwords
SMTP_USER=cuiattockcampus@gmail.com
SMTP_PASS=your_app_password_here
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465

# Cryptographic Session Secret for HMAC-SHA256 JWT cookie signing
# Must be at least 32 characters long. Set this in Vercel Environment Variables.
# Generate via: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=your_secret_32_characters_minimum_here

